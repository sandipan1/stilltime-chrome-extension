{
  "manifest_version": 3,
  "name": "Stilltime — Web Time Tracker",
  "version": "1.0.6",
  "description": "A calm, private view of where your browsing time goes.",
  "permissions": ["tabs", "storage", "idle", "alarms"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"},
    "default_title": "Stilltime",
    "default_popup": "popup.html"
  }
}
